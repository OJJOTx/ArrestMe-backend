# =============================================================================
# ArrestMe Cloud Backend — Environment Configuration Template
# Copy to .env for local development. NEVER commit real secrets to Git.
# =============================================================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
APP_VERSION=0.2.0

# Reverse proxy trust (set true behind Hostinger / LiteSpeed reverse proxy)
TRUST_PROXY=true

# Allowed CORS origins (comma-separated origins, or empty to disallow browser cross-origin)
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# MySQL 8 Database (Hostinger Managed MySQL)
# -----------------------------------------------------------------------------
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=u123456789_arrestme
DATABASE_USER=u123456789_arrestme_user
DATABASE_PASSWORD=replace_with_strong_mysql_password
DATABASE_CONNECTION_LIMIT=10
DATABASE_SSL=false

# Automatically run pending SQL migrations on server boot (false recommended if running via deploy step)
AUTO_MIGRATE_ON_STARTUP=false

# -----------------------------------------------------------------------------
# Authentication & Cryptography
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_minimum_32_byte_random_access_secret_value
JWT_ISSUER=arrestme-api
JWT_AUDIENCE=arrestme-android
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# -----------------------------------------------------------------------------
# Command & Session Coordination Limits
# -----------------------------------------------------------------------------
DEFAULT_COMMAND_TTL_SECONDS=300
MAX_SESSION_DURATION_MINUTES=720

# -----------------------------------------------------------------------------
# Protected Maintenance / Readiness Secret (for Hostinger Cron Jobs & Health Readiness)
# -----------------------------------------------------------------------------
MAINTENANCE_API_KEY=replace_with_minimum_32_byte_random_maintenance_secret

# -----------------------------------------------------------------------------
# Firebase Cloud Messaging (Optional in local dev; required for push wakeup in production)
# Escape newlines in FIREBASE_PRIVATE_KEY as \n when set via hPanel Environment Variables
# -----------------------------------------------------------------------------
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Enable interactive Swagger UI at /docs (recommended false in production)
ENABLE_SWAGGER_UI=false
