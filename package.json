{
  "name": "arrestme-backend",
  "version": "0.2.0",
  "description": "Cloud coordination backend for the ArrestMe Android digital detox & focus application",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "node dist/database/migrate-cli.js up",
    "migrate:status": "node dist/database/migrate-cli.js status",
    "openapi:generate": "npm run build && node dist/scripts/generate-openapi.js",
    "openapi:verify": "node dist/scripts/generate-openapi.js --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "firebase-admin": "^14.5.0",
    "mysql2": "^3.24.6",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  }
}
